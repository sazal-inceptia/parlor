# Parlor — Environment Configuration

# ─── AI Provider Selection ───
# Which LLM provider to use: openrouter, groq, gemini
# Each provider requires its own API key (see below).
AI_PROVIDER=openrouter

# ─── Provider: OpenRouter ───
# Get a key at: https://openrouter.ai/
# Supports 200+ models including Gemini, Llama, Mistral, etc.
# The default model google/gemini-3.1-flash-image has a generous free tier.
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# ─── Provider: Groq ───
# Get a key at: https://console.groq.com/
# Extremely fast inference on open-source models (Llama, Mixtral, etc.)
# Set AI_PROVIDER=groq and uncomment:
# GROQ_API_KEY=gsk_your_key_here

# ─── Provider: Gemini ───
# Get a key at: https://aistudio.google.com/app/apikeys
# Google's own models with free tier.
# Set AI_PROVIDER=gemini and uncomment:
# GEMINI_API_KEY=your_key_here

# ─── LLM Configuration ───
# Model to use with the selected provider.
#   OpenRouter: google/gemini-3.1-flash-image, meta-llama/llama-3.3-70b-instruct
#   Groq:       llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
#   Gemini:     gemini-2.0-flash-001, gemini-2.0-flash-lite-001
LLM_MODEL=google/gemini-3.1-flash-image
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512

# ─── Whisper STT (Local Model via Whisper.cpp) ───
# Model size: tiny, base, small, medium, large-v3-turbo, large-v3
# 'large-v3-turbo' ~3.5GB - best speed/accuracy for Bengali (recommended)
# 'large-v3' ~6GB - maximum accuracy, slightly slower
# Uses Whisper.cpp with Metal GPU acceleration on Apple Silicon.
# Models auto-download to ~/.cache/whisper-cpp/ on first use.
WHISPER_MODEL=large-v3-turbo

# Custom Python executable for Whisper (default: python3)
# WHISPER_PYTHON=python3

# ─── Cloud STT Fallback ───
# When local Whisper fails (OOM, model missing, etc.), the server falls
# back to an OpenAI-compatible /v1/audio/transcriptions API.
#
# Defaults to OPENROUTER_API_KEY if not set.  Set to your own API key
# for a different provider:
#   OpenAI:     https://api.openai.com/v1           (default)
#   OpenRouter: https://openrouter.ai/api/v1
#   DeepSeek:   (if they add Whisper support)
#
# FALLBACK_STT_API_KEY=sk-your-key-here
# FALLBACK_STT_BASE_URL=https://api.openai.com/v1
# FALLBACK_STT_MODEL=whisper-1

# ─── Server ───
PROXY_PORT=3000

