# Parlor Bengali Proxy — Environment Configuration

# ─── Google Gemini API ───
# Get your free API key at: https://aistudio.google.com/app/apikeys
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Groq Whisper API ───
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ─── Server ───
# Port for the proxy WebSocket server
PROXY_PORT=3000

# ─── Optional: Python Backend ───
# If you're running the Python FastAPI server alongside this proxy
PYTHON_BACKEND_URL=http://localhost:8000

# ─── TTS Setup (Optional) ───
# For actual Bengali audio output (instead of silence), install edge-tts:
#   pip install edge-tts
# Without this, the server will generate silent audio chunks (for testing)

